# Dockerfile de production — tokens injectés à l'exécution depuis l'environnement
# (alternative au Dockerfile historique qui embarquait les tokens dans l'image).
#
# Build :
#   docker build -t pwa-glpi:v3-prod -f Dockerfile.prod .
#
# Run — via variables d'environnement :
#   docker run -p 8085:80 \
#     -e GLPI_URL=https://your-glpi.example.com/apirest.php/ \
#     -e GLPI_APP_TOKEN=xxx \
#     -e GLPI_USER_TOKEN=yyy \
#     pwa-glpi:v3-prod
#
# Run — via Docker Swarm secrets (recommandé en prod) :
#   secrets glpi_url / glpi_app_token / glpi_user_token
#   → montés automatiquement dans /run/secrets/ par swarm, lus par l'entrypoint.

FROM nginx:stable-alpine

# curl pour le healthcheck du compose, gettext pour envsubst
RUN apk add --no-cache curl gettext

COPY . /usr/share/nginx/html
# Retirer le config.js "dev" → forcer la génération depuis le template au runtime
RUN rm -f /usr/share/nginx/html/config.js

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
